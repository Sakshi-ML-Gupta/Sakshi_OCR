def _demo_case() -> BenchmarkCase:
    lines = [
        "IGNOU Assignment Booklet",
        "Enrolment No: 123456",
        "",
        "Ans 1- The theme of concealment is central to the play.",
        "It appears through disguise and secrecy in several scenes.",
        "The characters hide their true identities to survive.",
        "",
        "Ans 2- Akam poetry deals with the inner, personal life.",
        "It focuses on love and domestic emotion rather than public affairs.",
        "",
        "Teacher's Signature",
    ]
    questions = [
        "1. Examine the theme of concealment in the play. (10)",
        "2. Write a short note on Akam poetry. (10)",
    ]
    ground_truth = [
        GroundTruthRange(ref="REF-A", start_line=3, end_line=5),
        GroundTruthRange(ref="REF-B", start_line=7, end_line=8),
    ]
    return BenchmarkCase(case_id="demo_1", lines=lines, questions=questions, ground_truth=ground_truth)


def _mock_model_good(system_prompt: str, user_prompt: str) -> str:
    return json.dumps({"ranges": [
        {"ref": "REF-A", "start_line": 3, "end_line": 5},
        {"ref": "REF-B", "start_line": 7, "end_line": 8},
    ]})


def _mock_model_cheats_with_text(system_prompt: str, user_prompt: str) -> str:
    # Simulates a non-compliant model that tries to answer with text
    # instead of indices -- this MUST be disqualified by the schema check.
    return json.dumps({"ranges": [
        {"ref": "REF-A", "start_line": "The theme of concealment...", "end_line": 5},
    ]})


def _mock_model_overlapping(system_prompt: str, user_prompt: str) -> str:
    return json.dumps({"ranges": [
        {"ref": "REF-A", "start_line": 3, "end_line": 8},   # swallows REF-B's lines too
        {"ref": "REF-B", "start_line": 7, "end_line": 8},
    ]})


if __name__ == "__main__":
    case = _demo_case()
    models = {
        "mock_good": _mock_model_good,
        "mock_cheats_with_text": _mock_model_cheats_with_text,
        "mock_overlapping": _mock_model_overlapping,
    }
    report = run_benchmark(models, [case])
    print(summarize(report))
    print()
    for model_name, results in report.items():
        for r in results:
            print(f"--- {model_name} / {r.case_id} ---")
            if not r.schema_ok:
                print(f"  DISQUALIFIED: {r.schema_error}")
                continue
            print(f"  violations: {r.violations}")
            print(f"  overlaps resolved: {r.overlap_count}")
            print(f"  precision={r.precision:.2f} recall={r.recall:.2f} f1={r.f1:.2f} mean_iou={r.mean_iou:.2f}")
            print(f"  extracted (python-sliced): {r.extracted_text}")
            print()
